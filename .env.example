# ============================================================
# Restaurant Leads — variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Aplicación ---
APP_NAME="Restaurant Leads"
ENV=development          # development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Seguridad ---
# Genera un valor seguro, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL (debe coincidir con docker-compose.yml) ---
POSTGRES_USER=restaurant_leads
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=restaurant_leads
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://restaurant_leads:change_me_in_dev@localhost:5432/restaurant_leads

# --- Logging ---
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Ingesta ---
# Overpass API (OpenStreetMap) es pública: no requiere clave.
# Límite recomendado para uso respetuoso (consultas cada X segundos).
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_REQUEST_INTERVAL_SECONDS=5
OVERPASS_TIMEOUT_SECONDS=60

# Google Places (OPCIONAL — no implementado; solo si en el futuro se
# dispone de clave y presupuesto. Dejar vacío para desactivarlo.)
GOOGLE_PLACES_API_KEY=

# --- IA (Milestone 8 — dejar vacío hasta entonces) ---
# Proveedor OpenAI-compatible gratuito (por ejemplo: groq o gemini).
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
